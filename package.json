{
  "name": "agreemobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run db:migrate && npm run db:seed && next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "db:seed": "node --experimental-strip-types src/db/seed.ts",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "test:integration": "node --test --experimental-strip-types --import ./scripts/register-alias-resolver.mjs --test-force-exit 'src/**/*.integration.ts'",
    "lint": "eslint ."
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.22",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/trip_planner

# The domain every generated link (magic links, invite links) points to.
# Set this to https://agreemobile.com once the domain is connected in
# Railway. Unset falls back to whatever host served the request -- fine for
# local dev, but in production that's Railway's own *.up.railway.app
# subdomain, which won't match a "from AgreeMobile" email and can read as a
# phishing mismatch to browsers and mail clients.
APP_URL=

# Both must be set to actually send magic-link email via Resend
# (https://resend.com). With either unset, sign-in links are logged to the
# console instead — that's what makes local dev work with no provider account.
RESEND_API_KEY=
# Include a display name if you like: "AgreeMobile <sign-in@agreemobile.com>".
# The address's domain must be verified in Resend first.
EMAIL_FROM=

# Powers automatic lat/long lookup from an address or location name (Google
# Maps Geocoding API), and the destination's time zone (Maps Time Zone API --
# enable both for this key: https://console.cloud.google.com/google/maps-apis).
# Unset just means items save with no coordinates, so the conflict checker
# can't estimate travel time for them, and a new trip falls back to the
# browser's own time zone instead of the destination's -- everything else
# still works.
GOOGLE_MAPS_API_KEY=

# Powers the "Look up cuisine & dietary info" button on Dining items
# (Anthropic Messages API, https://console.anthropic.com/settings/keys) --
# Claude reads the restaurant's own site/menu/reviews via web search to
# suggest a cuisine and which dietary needs it's known to accommodate.
# Unset just means that button's lookups quietly return nothing; cuisine and
# accommodates can always still be filled in by hand.
ANTHROPIC_API_KEY=

# Powers live flight status (delays, gate/terminal, baggage claim) on
# flight-subtype transport items -- AeroDataBox via RapidAPI
# (https://rapidapi.com/aedbx-aedbx/api/aerodatabox). Unset just means
# conflict analysis uses each leg's scheduled time instead of a live
# estimate -- everything else (the subtype buffers themselves, multi-leg
# flights) still works with no key at all.
AERODATABOX_API_KEY=

# Encrypts passport info (number, name, DOB, expiry, and the uploaded photo
# -- see lib/encryption.ts) before it's ever written to the database. Must
# be a base64-encoded 32-byte key -- generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset means the Passport section on the profile page is simply
# unavailable (and lib/passport.ts refuses to save anything) rather than
# ever storing sensitive data unencrypted. Once set, treat it like a
# database credential: losing it makes every already-saved passport record
# unrecoverable, and it must never be committed or logged. Rotating it
# requires re-encrypting existing rows (not handled automatically).
PASSPORT_ENCRYPTION_KEY=

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/trip_planner

# Both must be set to actually send magic-link email via Resend
# (https://resend.com). With either unset, sign-in links are logged to the
# console instead — that's what makes local dev work with no provider account.
RESEND_API_KEY=
# Include a display name if you like: "AgreeMobile <sign-in@agreemobile.com>".
# The address's domain must be verified in Resend first.
EMAIL_FROM=
